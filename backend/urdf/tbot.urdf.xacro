<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tbot">
  <xacro:arg name="wheel_separation" default="0.0"/>
  <xacro:arg name="wheel_radius" default="0.033482"/>
  <xacro:arg name="lidar_x" default="0.0"/><xacro:arg name="lidar_y" default="0.0"/>
  <xacro:arg name="imu_x" default="0.0"/><xacro:arg name="imu_y" default="0.0"/>
  <link name="base_footprint"/><link name="base_link"/><link name="laser"/><link name="imu_link"/>
  <link name="left_wheel_link"/><link name="right_wheel_link"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="$(arg lidar_x) $(arg lidar_y) 0.15"/></joint>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="$(arg imu_x) $(arg imu_y) 0.05"/></joint>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 $(eval arg('wheel_separation')/2) 0"/><axis xyz="0 1 0"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 $(eval -arg('wheel_separation')/2) 0"/><axis xyz="0 1 0"/></joint>
</robot>
